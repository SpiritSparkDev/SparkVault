<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Geistesfunke dark palette: purple-to-gold neon on near-black. Same key names as
         Palette.Light.xaml — App.xaml.cs swaps which of the two is merged, and every Style in
         Theme.xaml reads these via DynamicResource so the swap re-paints without reconstructing
         windows. -->
    <Color x:Key="AccentColor">#8A2BE2</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent100Brush" Color="#2E1B4A"/>
    <SolidColorBrush x:Key="Accent200Brush" Color="#3D2260"/>
    <SolidColorBrush x:Key="Accent300Brush" Color="#6B5B85"/>
    <SolidColorBrush x:Key="Accent600Brush" Color="#E23D6B"/>
    <SolidColorBrush x:Key="Accent700Brush" Color="#A855F7"/>
    <SolidColorBrush x:Key="Accent800Brush" Color="#E8D9FF"/>
    <SolidColorBrush x:Key="Accent900Brush" Color="#150A24"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="#FFD700"/>
    <SolidColorBrush x:Key="Accent2_100Brush" Color="#FFE066"/>
    <SolidColorBrush x:Key="Accent2_800Brush" Color="#17100A"/>

    <SolidColorBrush x:Key="BgBrush" Color="#0C0316"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#170229"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3EEFB"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B3A3C9"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#3A1F57"/>

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#1A0033" Offset="0"/>
        <GradientStop Color="#050007" Offset="0.75"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0"/>
        <GradientStop Color="#8A2BE2" Offset="0.55"/>
        <GradientStop Color="#FFD700" Offset="1"/>
    </LinearGradientBrush>

    <!-- Brand accent, not a neutral surface token — stays identical in both palettes. -->
    <LinearGradientBrush x:Key="RingGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0"/>
        <GradientStop Color="#FFD700" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
