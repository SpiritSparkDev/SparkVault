<Window x:Class="SparkVault.App.JobDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SparkVault" Height="640" Width="900" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Sidebar -->
        <StackPanel DockPanel.Dock="Left" Width="180" Background="{StaticResource SurfaceBrush}">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Height="640">
                <StackPanel>
                    <TextBlock x:Name="JobNameHeader" Text="Job" Style="{StaticResource HeadingTextStyle}"
                               Margin="16,16,16,16" TextTrimming="CharacterEllipsis"/>
                    <RadioButton x:Name="NavOverview" Content="Übersicht" GroupName="Nav"
                                 Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavFiles" Content="Dateiauswahl" GroupName="Nav"
                                 Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavHistory" Content="Verlauf" GroupName="Nav"
                                 Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavRestore" Content="Wiederherstellung" GroupName="Nav"
                                 Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Content="Einstellungen" GroupName="Nav"
                                 Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Margin="28,24,28,24">
            <!-- Übersicht -->
            <StackPanel x:Name="OverviewPanel">
                <TextBlock Text="Übersicht" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>

                <!-- Idle: last-run status + at-a-glance tiles -->
                <StackPanel x:Name="IdleView">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <DockPanel>
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource AccentBrush}"
                                     DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button x:Name="RunNowButton" Content="Jetzt sichern" Style="{StaticResource PrimaryButtonStyle}"
                                    DockPanel.Dock="Right" Click="RunNowButton_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTitleText" Text="Noch kein Backup" Style="{StaticResource HeadingTextStyle}" FontSize="16"/>
                                <TextBlock x:Name="StatusMetaText" Text="" Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="NÄCHSTES BACKUP" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="NextRunText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ZIELE" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="TargetsText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LETZTE GRÖSSE" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="LastSizeText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Running: live progress -->
                <StackPanel x:Name="RunningView" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="PauseButton" Content="Pausieren" Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right" Click="PauseButton_Click"/>
                                <Button x:Name="RunCancelButton" Content="Abbrechen" Style="{StaticResource GhostButtonStyle}"
                                        DockPanel.Dock="Right" Margin="0,0,8,0" Click="CancelButton_Click"/>
                                <TextBlock x:Name="SpeedEtaText" Style="{StaticResource MutedTextStyle}"
                                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="PercentText" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="38" Foreground="{StaticResource Accent700Brush}"/>
                                    <TextBlock Text="%" Style="{StaticResource HeadingTextStyle}" FontSize="22" Foreground="{StaticResource Accent700Brush}" Margin="0,0,0,3" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar x:Name="RunProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10"/>
                            <TextBlock x:Name="CurrentFileText" Style="{StaticResource MutedTextStyle}"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="DATEIEN" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunFilesText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ÜBERTRAGEN" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunBytesText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ZIEL" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunTargetText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- Dateiauswahl -->
            <DockPanel x:Name="FilesPanel" Visibility="Collapsed" LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Dateiauswahl" Style="{StaticResource HeadingTextStyle}" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FilesSelectedSizeText" Style="{StaticResource MutedTextStyle}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="FoldersListBox" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource MutedTextStyle}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsIncluded}" Checked="FolderCheckBox_Changed" Unchecked="FolderCheckBox_Changed"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Verlauf -->
            <DataGrid x:Name="HistoryGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartedAt}" Width="140"/>
                    <DataGridTextColumn Header="Ende" Binding="{Binding EndedAt}" Width="140"/>
                    <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Dateien" Binding="{Binding FileCount}" Width="70"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding TotalBytes}" Width="90"/>
                    <DataGridTextColumn Header="Fehler" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Wiederherstellung -->
            <Grid x:Name="RestorePanel" Visibility="Collapsed">
                <StackPanel x:Name="RestoreEmptyState">
                    <TextBlock Text="Wiederherstellung" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>
                    <TextBlock Text="Noch keine Sicherung zum Wiederherstellen vorhanden." Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>

                <StackPanel x:Name="RestoreContent" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Wiederherstellung" Style="{StaticResource HeadingTextStyle}" FontSize="22"/>
                        <ComboBox x:Name="RestoreTargetCombo" DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right"
                                  SelectionChanged="RestoreTargetCombo_SelectionChanged" Visibility="Collapsed"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True">
                        <ListBox x:Name="RestoreVersionsListBox" DockPanel.Dock="Left" Width="220" BorderThickness="0" Margin="0,0,20,0"
                                 SelectionChanged="RestoreVersionsListBox_SelectionChanged" DisplayMemberPath="Label"/>
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="AUSGEWÄHLTER STAND" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RestoreSelectedLabelText" Style="{StaticResource HeadingTextStyle}" FontSize="18" Margin="0,4,0,10"/>
                                <TextBlock x:Name="RestoreSelectedMetaText" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>
                                <TextBlock Text="Dateien werden an ihren ursprünglichen Ort zurückgespielt." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button x:Name="RestoreButton" Content="Wiederherstellen" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" Click="RestoreButton_Click"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="RestoreRunningView" Visibility="Collapsed">
                    <TextBlock Text="Wiederherstellung läuft" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="RestoreCancelButton" Content="Abbrechen" Style="{StaticResource GhostButtonStyle}"
                                        DockPanel.Dock="Right" Click="RestoreCancelButton_Click"/>
                                <TextBlock x:Name="RestorePercentText" Text="0" Style="{StaticResource HeadingTextStyle}" FontSize="38" Foreground="{StaticResource Accent700Brush}"/>
                                <TextBlock Text="%" Style="{StaticResource HeadingTextStyle}" FontSize="22" Foreground="{StaticResource Accent700Brush}" Margin="4,0,0,3" VerticalAlignment="Bottom"/>
                            </DockPanel>
                            <ProgressBar x:Name="RestoreProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,10"/>
                            <TextBlock x:Name="RestoreCurrentFileText" Style="{StaticResource MutedTextStyle}"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Einstellungen -->
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <TextBlock Text="Einstellungen" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>

                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <DockPanel>
                        <Button Content="Bearbeiten" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Click="EditSettings_Click"/>
                        <StackPanel><TextBlock Text="Name" FontWeight="SemiBold"/><TextBlock x:Name="SettingsNameText" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <DockPanel>
                        <Button Content="Bearbeiten" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Click="EditSettings_Click"/>
                        <StackPanel><TextBlock Text="Quellpfad" FontWeight="SemiBold"/><TextBlock x:Name="SettingsSourceText" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <DockPanel>
                        <Button Content="Bearbeiten" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Click="EditSettings_Click"/>
                        <StackPanel><TextBlock Text="Ziele" FontWeight="SemiBold"/><TextBlock x:Name="SettingsTargetsText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/></StackPanel>
                    </DockPanel>
                </Border>
                <Border Padding="0,14">
                    <DockPanel>
                        <Button Content="Bearbeiten" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Click="EditSettings_Click"/>
                        <StackPanel><TextBlock Text="Zeitplan" FontWeight="SemiBold"/><TextBlock x:Name="SettingsScheduleText" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
