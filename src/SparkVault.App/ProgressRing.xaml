<UserControl x:Class="SparkVault.App.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Ellipse x:Name="TrackEllipse" Stroke="{DynamicResource DividerBrush}"/>
        <Path x:Name="ArcPath" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource RingGradientBrush}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CenterValueText" FontFamily="{StaticResource BodyFont}" FontWeight="Bold" FontSize="34"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="CenterLabelText" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
