<Window x:Class="SparkVault.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geistes Funke" Height="420" Width="480" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}" Icon="pack://application:,,,/Assets/icon.ico">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/logo-light.png" Height="64" Width="64" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <TextBlock Text="Willkommen bei Geistes Funke" Style="{StaticResource HeadingTextStyle}" FontSize="24"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="Geistes Funke sichert deine Ordner automatisch nach Zeitplan – lokal, per FTP/SFTP oder in die Cloud. Leg jetzt deinen ersten Sicherungsjob an, oder schau dich erst in Ruhe um."
                       TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" FontSize="14" Margin="0,0,0,28"/>
            <Button x:Name="CreateFirstJobButton" Content="Ersten Job einrichten" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center" Padding="20,8" Click="CreateFirstJob_Click"/>
            <Button x:Name="SkipButton" Content="Später" Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,10,0,0" Click="Skip_Click"/>
        </StackPanel>
    </Grid>
</Window>
