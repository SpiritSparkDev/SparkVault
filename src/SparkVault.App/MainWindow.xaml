<Window x:Class="SparkVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SparkVault.App"
        Title="Geistes Funke" Height="680" Width="980"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource BodyFont}"
        Icon="pack://application:,,,/Assets/icon.ico"
        Closing="Window_Closing">
    <DockPanel>
        <!-- Sidebar: job switcher on top, the selected job's tab nav below it -->
        <StackPanel DockPanel.Dock="Left" Width="240" Background="{DynamicResource SurfaceBrush}">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <DockPanel Margin="12,12,12,8">
                        <Button x:Name="AppSettingsButton" Width="34" Padding="0" DockPanel.Dock="Right" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" ToolTip="Einstellungen" Click="AppSettingsButton_Click">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Line X1="3" Y1="6" X2="21" Y2="6" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"/>
                                    <Line X1="3" Y1="12" X2="21" Y2="12" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"/>
                                    <Line X1="3" Y1="18" X2="21" Y2="18" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="5" Canvas.Top="3" Width="6" Height="6" Fill="{DynamicResource Accent2Brush}"/>
                                    <Ellipse Canvas.Left="13" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource Accent2Brush}"/>
                                    <Ellipse Canvas.Left="9" Canvas.Top="15" Width="6" Height="6" Fill="{DynamicResource Accent2Brush}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="AddJobButton" Content="+ Neuer Job" Style="{StaticResource SecondaryButtonStyle}"
                                Click="AddJobButton_Click"/>
                    </DockPanel>

                    <ListBox x:Name="JobsList" BorderThickness="0" Background="Transparent" MaxHeight="240"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="JobsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="8,1" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent100Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent100Brush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" DockPanel.Dock="Left"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastRunDisplay}" Style="{StaticResource MutedTextStyle}" FontSize="10"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="12,8"/>

                    <StackPanel x:Name="SidebarNavPanel">
                        <RadioButton x:Name="NavOverview" Content="Übersicht" GroupName="Nav"
                                     Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavFiles" Content="Dateiauswahl" GroupName="Nav"
                                     Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavHistory" Content="Verlauf" GroupName="Nav"
                                     Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavRestore" Content="Wiederherstellung" GroupName="Nav"
                                     Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Content="Einstellungen" GroupName="Nav"
                                     Style="{StaticResource SidebarNavStyle}" Checked="Nav_Checked"/>
                        <Button x:Name="DeleteJobButton" Content="Job löschen" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Left" Margin="14,16,12,8" Click="DeleteJobButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Margin="28,24,28,24">
            <!-- Empty state: no job selected (fresh install after Welcome-skip, or all jobs deleted) -->
            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Kein Job ausgewählt" Style="{StaticResource HeadingTextStyle}" FontSize="20"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Lege links einen neuen Job an, um loszulegen." Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Übersicht -->
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Übersicht" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>

                <!-- Idle: hero ring status + at-a-glance tiles -->
                <StackPanel x:Name="IdleView">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="24">
                        <StackPanel HorizontalAlignment="Center">
                            <local:ProgressRing x:Name="StatusRing" Diameter="140" RingThickness="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StatusTitleText" Text="Noch kein Backup" Style="{StaticResource HeadingTextStyle}" FontSize="16"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="StatusMetaText" Text="" Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="NÄCHSTES BACKUP" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="NextRunText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ZIELE" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="TargetsText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LETZTE GRÖSSE" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="LastSizeText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button x:Name="RunNowButton" Content="Jetzt sichern" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Padding="32,10" Click="RunNowButton_Click"/>
                </StackPanel>

                <!-- Running: live ring progress -->
                <StackPanel x:Name="RunningView" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="24">
                        <StackPanel HorizontalAlignment="Center">
                            <DockPanel Width="220" Margin="0,0,0,14">
                                <Button x:Name="RunCancelButton" Content="Abbrechen" Style="{StaticResource GhostButtonStyle}"
                                        DockPanel.Dock="Left" Click="CancelButton_Click"/>
                                <Button x:Name="PauseButton" Content="Pausieren" Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right" Click="PauseButton_Click"/>
                            </DockPanel>
                            <local:ProgressRing x:Name="RunRing" Diameter="140" RingThickness="12" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SpeedEtaText" Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock x:Name="CurrentFileText" Style="{StaticResource MutedTextStyle}"
                                       FontFamily="Consolas" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="DATEIEN" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunFilesText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ÜBERTRAGEN" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunBytesText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ZIEL" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RunTargetText" Style="{StaticResource HeadingTextStyle}" FontSize="16" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Dateiauswahl -->
            <DockPanel x:Name="FilesPanel" Visibility="Collapsed" LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Dateiauswahl" Style="{StaticResource HeadingTextStyle}" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FilesSelectedSizeText" Style="{StaticResource MutedTextStyle}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="FoldersListBox" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <DockPanel>
                                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource MutedTextStyle}"
                                               DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsIncluded}" Checked="FolderCheckBox_Changed" Unchecked="FolderCheckBox_Changed"
                                              VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" FontSize="11"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Verlauf -->
            <DataGrid x:Name="HistoryGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartedAt}" Width="140"/>
                    <DataGridTextColumn Header="Ende" Binding="{Binding EndedAt}" Width="140"/>
                    <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Dateien" Binding="{Binding FileCount}" Width="70"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding TotalBytes}" Width="90"/>
                    <DataGridTextColumn Header="Fehler" Binding="{Binding ErrorMessage}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Wiederherstellung -->
            <Grid x:Name="RestorePanel" Visibility="Collapsed">
                <StackPanel x:Name="RestoreEmptyState">
                    <TextBlock Text="Wiederherstellung" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>
                    <TextBlock Text="Noch keine Sicherung zum Wiederherstellen vorhanden." Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>

                <StackPanel x:Name="RestoreContent" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Wiederherstellung" Style="{StaticResource HeadingTextStyle}" FontSize="22"/>
                        <ComboBox x:Name="RestoreTargetCombo" DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right"
                                  SelectionChanged="RestoreTargetCombo_SelectionChanged" Visibility="Collapsed"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True">
                        <ListBox x:Name="RestoreVersionsListBox" DockPanel.Dock="Left" Width="220" BorderThickness="0" Margin="0,0,20,0"
                                 SelectionChanged="RestoreVersionsListBox_SelectionChanged" DisplayMemberPath="Label"/>
                        <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="AUSGEWÄHLTER STAND" Style="{StaticResource MutedTextStyle}"/>
                                <TextBlock x:Name="RestoreSelectedLabelText" Style="{StaticResource HeadingTextStyle}" FontSize="18" Margin="0,4,0,10"/>
                                <TextBlock x:Name="RestoreSelectedMetaText" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,14"/>
                                <TextBlock Text="Dateien werden an ihren ursprünglichen Ort zurückgespielt." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Button x:Name="RestoreButton" Content="Wiederherstellen" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" Click="RestoreButton_Click"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="RestoreRunningView" Visibility="Collapsed">
                    <TextBlock Text="Wiederherstellung läuft" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="24">
                        <StackPanel HorizontalAlignment="Center">
                            <Button x:Name="RestoreCancelButton" Content="Abbrechen" Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14" Click="RestoreCancelButton_Click"/>
                            <local:ProgressRing x:Name="RestoreRing" Diameter="120" RingThickness="10" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RestoreCurrentFileText" Style="{StaticResource MutedTextStyle}"
                                       FontFamily="Consolas" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Einstellungen -->
            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock x:Name="SettingsHeaderText" Text="Einstellungen" Style="{StaticResource HeadingTextStyle}" FontSize="22" Margin="0,0,0,16"/>

                    <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="SettingsNameBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Quellpfad" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,14">
                        <Button Content="..." Width="34" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="SettingsBrowseSource_Click"/>
                        <TextBox x:Name="SettingsSourcePathBox" Margin="0,0,8,0"/>
                    </DockPanel>

                    <TextBlock Text="Ziele" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox x:Name="SettingsTargetsListBox" Height="80" Margin="0,0,0,6" DisplayMemberPath="Description"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Hinzufügen" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" Click="SettingsAddTarget_Click"/>
                        <Button Content="Bearbeiten" Style="{StaticResource SecondaryButtonStyle}" Padding="10,3" Margin="8,0,0,0" Click="SettingsEditTarget_Click"/>
                        <Button Content="Entfernen" Style="{StaticResource GhostButtonStyle}" Padding="10,3" Margin="8,0,0,0" Click="SettingsRemoveTarget_Click"/>
                    </StackPanel>

                    <TextBlock Text="Ausschlussmuster (eine Zeile pro Muster, z. B. *.tmp)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="SettingsExcludePatternsBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Zeitplan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SettingsScheduleTypeCombo" Margin="0,0,0,8" SelectionChanged="SettingsScheduleTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Manuell"/>
                        <ComboBoxItem Content="Intervall (Stunden)"/>
                        <ComboBoxItem Content="Täglich um"/>
                    </ComboBox>
                    <TextBlock x:Name="SettingsIntervalLabel" Text="Intervall in Stunden" Margin="0,0,0,4"/>
                    <TextBox x:Name="SettingsIntervalHoursBox" Margin="0,0,0,14"/>
                    <TextBlock x:Name="SettingsDailyAtLabel" Text="Uhrzeit (HH:mm)" Margin="0,0,0,4"/>
                    <TextBox x:Name="SettingsDailyAtTimeBox" Margin="0,0,0,14"/>

                    <Button x:Name="SettingsSaveButton" Content="Speichern" Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="SettingsSave_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
